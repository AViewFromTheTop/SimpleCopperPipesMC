{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Adds intuitive and simple-to-understand Copper Pipes to Minecraft.",
  "authors": [
    "Lunade/AViewFromTheTop"
  ],
  "contributors": [
    "Ethan Stokes"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${source_url}",
    "issues": "${issues_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/simple_copper_pipes/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.lunade.copper.SimpleCopperPipesFabric"
    ],
    "client": [
      "net.lunade.copper.SimpleCopperPipesFabricClient"
    ],
    "fabric-datagen": [
      "net.lunade.copper.data.SCPDataGenerator"
    ],
    "modmenu": [
      "net.lunade.copper.config.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "simple_copper_pipes.mixins.json",
    "simple_copper_pipes.create.mixins.json"
  ],
  "accessWidener": "simple_copper_pipes.classtweaker",
  "depends": {
    "frozenlib": "${frozenlib_version}",
    "fabricloader": "${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "cloth-config": "*",
    "modmenu": "*",
    "thecopperierage": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "X": "https://x.com/FB_Oasis",
        "Bluesky": "https://bsky.app/profile/frozenblock.bsky.social",
        "modmenu.discord": "https://discord.gg/frozenblock",
        "modmenu.modrinth": "https://modrinth.com/organization/frozenblock",
        "modmenu.youtube": "https://www.youtube.com/@frozenblockmoddingoasismod",
        "modmenu.kofi": "https://ko-fi.com/frozenblock"
      }
    },
    "frozenlib_registry": {
      "mod_protocol": $protocol_version
    }
  }
}
